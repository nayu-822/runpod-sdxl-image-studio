# Copy this file to .env and adjust paths for the target RunPod Pod.
IMAGE_STUDIO_ENV=development
IMAGE_STUDIO_HOST=0.0.0.0
IMAGE_STUDIO_PORT=7860
IMAGE_STUDIO_TIMEZONE=Asia/Tokyo

COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_WS_URL=ws://127.0.0.1:8188/ws
COMFYUI_OUTPUT_DIR=/workspace/ComfyUI/output
COMFYUI_TIMEOUT_SECONDS=30
IMAGE_STUDIO_GENERATION_TIMEOUT_SECONDS=600
IMAGE_STUDIO_HISTORY_POLL_INTERVAL_SECONDS=2
IMAGE_STUDIO_HISTORY_MAX_ATTEMPTS=10
IMAGE_STUDIO_MAX_OUTPUT_IMAGE_BYTES=52428800
IMAGE_STUDIO_MAX_UPSCALE_INPUT_IMAGE_BYTES=52428800
IMAGE_STUDIO_MAX_METADATA_IMPORT_IMAGE_BYTES=52428800
IMAGE_STUDIO_MAX_METADATA_SIDECAR_BYTES=2000000
IMAGE_STUDIO_MAX_METADATA_RAW_BYTES=4000000

IMAGE_STUDIO_DATA_DIR=/workspace/image-studio-data
IMAGE_STUDIO_DATABASE_URL=
IMAGE_STUDIO_WORKFLOW_DIR=/workspace/runpod-sdxl-image-studio/workflows

IMAGE_STUDIO_CHECKPOINT_DIR=/workspace/ComfyUI/models/checkpoints
IMAGE_STUDIO_LORA_DIR=/workspace/ComfyUI/models/loras
IMAGE_STUDIO_VAE_DIR=/workspace/ComfyUI/models/vae
IMAGE_STUDIO_UPSCALER_DIR=/workspace/ComfyUI/models/upscale_models

IMAGE_STUDIO_MAX_WIDTH=2048
IMAGE_STUDIO_MAX_HEIGHT=2048
IMAGE_STUDIO_MAX_PIXELS=4194304
IMAGE_STUDIO_MAX_BATCH_COUNT=8
IMAGE_STUDIO_MAX_LORAS=8
IMAGE_STUDIO_MAX_UPSCALE_FACTOR=4.0
IMAGE_STUDIO_THUMBNAIL_SIZE=512
IMAGE_STUDIO_MAX_LORA_THUMBNAIL_BYTES=10485760
IMAGE_STUDIO_LORA_THUMBNAIL_MAX_EDGE=512
IMAGE_STUDIO_HISTORY_PAGE_SIZE=20
IMAGE_STUDIO_HISTORY_SEARCH_PAGE_SIZE=20
IMAGE_STUDIO_HISTORY_SEARCH_MAX_PAGE_SIZE=100
IMAGE_STUDIO_HISTORY_SEARCH_MAX_TEXT_LENGTH=500
IMAGE_STUDIO_PRESET_NAME_MAX_LENGTH=100
IMAGE_STUDIO_PRESET_DESCRIPTION_MAX_LENGTH=1000
IMAGE_STUDIO_RECENT_SETTINGS_LIMIT=10
IMAGE_STUDIO_PROMPT_DIFF_MAX_LENGTH=20000
IMAGE_STUDIO_HISTORY_THUMBNAIL_MAX_EDGE=384
IMAGE_STUDIO_STALE_PENDING_SECONDS=300
IMAGE_STUDIO_RECOVERY_MAX_ITEMS=50
IMAGE_STUDIO_QUEUE_POLL_INTERVAL_SECONDS=2
IMAGE_STUDIO_QUEUE_LEASE_SECONDS=60
IMAGE_STUDIO_QUEUE_HEARTBEAT_SECONDS=20
IMAGE_STUDIO_QUEUE_MAX_PENDING_JOBS=200
IMAGE_STUDIO_BATCH_MAX_ITEMS=50
IMAGE_STUDIO_RECONCILIATION_GRACE_SECONDS=120
IMAGE_STUDIO_QUEUE_AUTO_REFRESH_SECONDS=3
IMAGE_STUDIO_IMAGE_DOWNLOAD_STALE_AFTER_SECONDS=300
IMAGE_STUDIO_METADATA_REQUEST_MAX_WAIT_SECONDS=60
IMAGE_STUDIO_METADATA_CONNECT_TIMEOUT_SECONDS=10
IMAGE_STUDIO_METADATA_READ_TIMEOUT_SECONDS=30
IMAGE_STUDIO_METADATA_RATE_LIMITER_WAIT_SECONDS=5
IMAGE_STUDIO_METADATA_HEARTBEAT_INTERVAL_SECONDS=5
IMAGE_STUDIO_MAX_TRIGGER_WORDS=50
IMAGE_STUDIO_MAX_COMPATIBLE_MODELS=20

RCLONE_REMOTE=
RCLONE_BASE_PATH=RunPodSDXLImageStudio
RCLONE_CONFIG=
IMAGE_STUDIO_DRIVE_SYNC_POLL_INTERVAL_SECONDS=5
IMAGE_STUDIO_DRIVE_SYNC_LEASE_SECONDS=120
IMAGE_STUDIO_DRIVE_SYNC_HEARTBEAT_SECONDS=30
IMAGE_STUDIO_DRIVE_DISCOVERY_BATCH_SIZE=100
IMAGE_STUDIO_RCLONE_CONNECTION_TIMEOUT_SECONDS=20
