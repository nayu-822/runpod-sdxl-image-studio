# RunPod Custom Template environment.  Replace the Secret placeholder through
# the RunPod Template UI; do not commit the decoded rclone.conf or any token.
IMAGE_STUDIO_ENV=production

IMAGE_STUDIO_HOST=0.0.0.0
IMAGE_STUDIO_PORT=7860
IMAGE_STUDIO_TIMEZONE=Asia/Tokyo

COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_WS_URL=ws://127.0.0.1:8188/ws
COMFYUI_OUTPUT_DIR=/workspace/runpod-slim/ComfyUI/output

IMAGE_STUDIO_DATA_DIR=/workspace/image-studio-data
IMAGE_STUDIO_WORKFLOW_DIR=/opt/image-studio/workflows

IMAGE_STUDIO_CHECKPOINT_DIR=/workspace/runpod-slim/ComfyUI/models/checkpoints
IMAGE_STUDIO_LORA_DIR=/workspace/runpod-slim/ComfyUI/models/loras
IMAGE_STUDIO_VAE_DIR=/workspace/runpod-slim/ComfyUI/models/vae
IMAGE_STUDIO_UPSCALER_DIR=/workspace/runpod-slim/ComfyUI/models/upscale_models

RCLONE_REMOTE=drive
RCLONE_BASE_PATH=RunPodSDXLImageStudio
RCLONE_CONFIG=/run/image-studio/rclone.conf
IMAGE_STUDIO_RCLONE_CONFIG_B64={{ RUNPOD_SECRET_image_studio_rclone_config_b64 }}

IMAGE_STUDIO_REMOTE_MODEL_ENABLED=true
IMAGE_STUDIO_REMOTE_MODEL_BASE_PATH=SDXLModels
IMAGE_STUDIO_REMOTE_CHECKPOINT_SUBDIR=checkpoints
IMAGE_STUDIO_REMOTE_LORA_SUBDIR=loras
IMAGE_STUDIO_REMOTE_VAE_SUBDIR=vae
IMAGE_STUDIO_REMOTE_UPSCALER_SUBDIR=upscale_models

IMAGE_STUDIO_STATE_SYNC_ENABLED=true
IMAGE_STUDIO_STATE_SYNC_RESTORE_ON_STARTUP=true
IMAGE_STUDIO_STATE_SYNC_SUBDIR=state
IMAGE_STUDIO_RESTORE_LAST_SETTINGS_ON_STARTUP=true
IMAGE_STUDIO_AUTO_PREPARE_LAST_MODELS=true

# Keep the first production deploy safe.  Enable only after the full flow is
# verified on a fresh Pod.
IMAGE_STUDIO_AUTO_TERMINATE_ENABLED=false
IMAGE_STUDIO_AUTO_TERMINATE_GRACE_SECONDS=15
IMAGE_STUDIO_AUTO_TERMINATE_CHECK_INTERVAL_SECONDS=2

IMAGE_STUDIO_BOOTSTRAP_COMFYUI_TIMEOUT_SECONDS=900
IMAGE_STUDIO_BOOTSTRAP_COMFYUI_MONITOR_INTERVAL_SECONDS=5
IMAGE_STUDIO_BOOTSTRAP_COMFYUI_FAILURE_THRESHOLD=12
IMAGE_STUDIO_BOOTSTRAP_SHUTDOWN_GRACE_SECONDS=30
